{
  "name": "woc-system",
  "version": "2.0.0",
  "description": "Discord-Bot für World Of Community",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --ignore 'data/*' src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "node scripts/check-load.js",
    "update": "node update.js"
  },
  "imports": {
    "#client": "./src/client.js",
    "#config": "./src/config/index.js",
    "#config/*": "./src/config/*",
    "#core/*": "./src/core/*",
    "#db/*": "./src/database/*",
    "#models/*": "./src/database/models/*",
    "#systems/*": "./src/systems/*",
    "#utils/*": "./src/utils/*"
  },
  "author": "World Of Community",
  "license": "ISC",
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "ascii-table": "^0.0.9",
    "axios": "^1.20.0",
    "chalk": "^5.6.2",
    "country-flag-utils": "^2.0.1",
    "discord-api-types": "^0.38.56",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "mongoose": "^9.11.2",
    "ms": "^2.1.3",
    "node-cron": "^4.6.0",
    "node-schedule": "^2.1.1",
    "open-google-translator": "^1.0.5",
    "rss-parser": "^3.13.0",
    "tar": "^7.5.22",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
