# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
APPLICATION_ID=your_application_id_here

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Server Configuration
GUILD_ID=your_server_id_here

# Channel IDs
CHANGELOG_CHANNEL=changelog_channel_id
AUTO_DELETE_CHANNEL=auto_delete_channel_id
VORSCHLAEGE_CHANNEL=vorschlaege_channel_id
THREADS_CHANNEL=threads_channel_id
WILLKOMMEN_CHANNEL=willkommen_channel_id
BAN_LOG_CHANNEL=ban_log_channel_id

# Category IDs
CATEGORY_1=category_1_id
CATEGORY_2=category_2_id
CATEGORY_3=category_3_id
CATEGORY_4=category_4_id
CATEGORY_5=category_5_id

# Server Info
VANITY_URL=your_vanity_url
SERVER_TAG=your_server_tag

# Role IDs
VANITY_TAG_ROLE=vanity_tag_role_id
VANITY_ROLE=vanity_role_id
VERIFY_ROLE=verify_role_id
BAN_ROLE=ban_role_id
MEMBER_ROLE=member_role_id
CHANGELOG_ROLE=changelog_role_id
BUMP_ROLE=bump_role_id

# Emoji Roles (comma separated)
EMOJI_ROLES=role1,role2,role3,role4,role5,role6,role7,role8
