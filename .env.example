# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=815919809379172354

# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster/db
# MONGO_MAX_RETRIES=5

# Redis shared by bot and dashboard (redis://user:pass@host:port)
REDIS_URL=

# Dashboard (npm run dashboard)
# DASHBOARD_PORT=3000
# DASHBOARD_TOKEN=change-me

# Twitch status system (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 key (/youtube command)
YOUTUBE_API_KEY=

# Optional for update.js: GitHub token (only needed if the repo is private) and branch
# GITHUB_TOKEN=
# UPDATE_BRANCH=main

# development | production
NODE_ENV=production
# debug | info | warn | error
LOG_LEVEL=info
